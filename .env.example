# Go 服务直接读取进程环境变量，不会隐式加载 .env。
# Docker Compose 自动读取同目录 .env；PowerShell 请用 $env:变量名 赋值。
HADALBOT_ENVIRONMENT=development
HADALBOT_HTTP_ADDRESS=127.0.0.1:18878
HADALBOT_HTTP_API_KEY=
HADALBOT_DATABASE_ENABLED=false
HADALBOT_DATABASE_DSN=
HADALBOT_REDIS_ENABLED=false
HADALBOT_REDIS_URL=redis://127.0.0.1:16379/0
# 仅用于独立 Compose 开发数据库，启用 Compose 前请填写本地密码。
POSTGRES_PASSWORD=
# 上游SDK默认关闭；只有显式启用才初始化连接池/事件worker。
HADALBOT_QIANXUN_ENABLED=false
HADALBOT_QIANXUN_MODE=framework
HADALBOT_QIANXUN_BASE_URL=http://127.0.0.1:7777
HADALBOT_QIANXUN_SAFE_KEY=
HADALBOT_QIANXUN_WXID=
HADALBOT_QIANXUN_CALLBACK_ENABLED=false
HADALBOT_QIANXUN_CALLBACK_TOKEN=
HADALBOT_QIANXUN_WEBSOCKET_ENABLED=false
HADALBOT_QIANXUN_WEBSOCKET_URL=
HADALBOT_MIHOYO_ENABLED=false
HADALBOT_PLUGINS_ENABLED=false
HADALBOT_PLUGINS_TYPESCRIPT=false
HADALBOT_PLUGINS_DIRECTORY=plugins
HADALBOT_PLUGINS_NODE=node
HADALBOT_PLUGINS_MAX_TS_WORKERS=4
# 启用ID、每插件能力和配置建议使用本地YAML；不要直接指向旧项目插件根目录。
# 需要代理时使用Go标准HTTPS_PROXY；没有代理时不要填。
# HTTPS_PROXY=http://127.0.0.1:7897
